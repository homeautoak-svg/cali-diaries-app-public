# Copy this file to ".env" and adjust it if needed. Never share your .env publicly.
# Kopiere diese Datei nach ".env" und passe sie bei Bedarf an. Die .env nie veroeffentlichen.

# Allowed origin for API requests. "*" allows all, which is fine as long as the server is
# only reachable in your private network or VPN.
ALLOWED_ORIGIN=*

# Optional HTTPS, e.g. with a Tailscale certificate (see README). Paths inside the container.
# Leave empty to run HTTP only.
TLS_CERT_FILE=
TLS_KEY_FILE=
TLS_PORT=4443
